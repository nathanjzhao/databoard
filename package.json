{
  "name": "datasecretshare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:schema": "node scripts/gen-schema-module.mjs",
    "dev": "npm run gen:schema && next dev --port 3947",
    "build": "npm run gen:schema && next build",
    "start": "next start",
    "seed": "npm run gen:schema && node scripts/seed.ts",
    "migrate:buyer-tokens": "npm run gen:schema && node scripts/migrate-buyer-tokens.ts",
    "grant-operator": "npm run gen:schema && node scripts/grant-operator.ts",
    "reset-db": "node scripts/reset-db.mjs",
    "backup": "node scripts/backup.ts",
    "backup:prod": "node scripts/backup.ts --prod",
    "restore": "node scripts/restore.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1116.0",
    "@cloudflare/voprf-ts": "^1.0.0",
    "@libsql/client": "^0.17.4",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
