# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# blind tender: the sqlite database and its WAL sidecars
/data/

# blind tender: database dumps (password hashes + pseudonymous content, private)
/backups/

# blind tender: generated from db/schema.sql before dev/build/seed
/lib/schema.generated.ts

# proof-run screenshots and playwright output
/verify/
/test-results/
/playwright-report/
*.local

# hardening spec: distDirs of the extra dev servers it spawns
/.next-test-*/
